<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DshDesktop</AssemblyName>
    <RootNamespace>DshDesktop</RootNamespace>
    <!-- 官方 DeepSeek Harness 图标（从 dsh-web-frontend/dist/favicon.svg 渲染生成） -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- SystemAware：跟随会话系统 DPI（ToDesk 虚拟显示器下 PerMonitorV2 会被 OS 按 96/120 压缩导致界面错乱） -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- 单文件发布：自包含 + 原生库/内容文件全部打进 exe（WebView2Loader 需要 IncludeAllContentForSelfExtract） -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- 压缩单文件内的托管程序集，减小体积（首次启动稍慢） -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

</Project>
